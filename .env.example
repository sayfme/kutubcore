# KutubCore example config — copy to .env and adjust.
# Only real secrets belong in .env, never commit .env.

ADDR=:8080
DB_PATH=data/kutubcore.db
LOG_LEVEL=info

# Session lifetime in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720
# Set to true only behind HTTPS. Keep false for localhost http.
COOKIE_SECURE=false

# Where uploaded files live (default data/files; gitignored).
FILE_DIR=data/files

# Future (Milestone 5, not used yet):
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
